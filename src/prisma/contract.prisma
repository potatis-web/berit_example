// use prisma-8
model User {
  id       String    @id @default(uuid())
  phone    String    @unique
  name     String
  hash     String
  salt     String
  sessions Session[]
  bids     Bid[]
}

model Session {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String
}

model Item {
  id           String @id @default(uuid())
  description  String
  asking_price Int
  bids         Bid[]
}

model Bid {
  id        String      @id @default(uuid())
  price     Int
  creator   User        @relation(fields: [creatorId], references: [id])
  creatorId String
  item      Item        @relation(fields: [itemId], references: [id])
  itemId    String
  createdAt Timestamptz @default(now())
}
