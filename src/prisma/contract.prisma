// use prisma-8
model User {
  id        String    @id @default(uuid())
  name      String    @unique
  hash      String    
  salt      String    
  sessionid String    @default(uuid())
}

model Motion {
  id        String    @id @default(uuid())
  text      String

  votes     Vote[]
}

model Vote {
  id        String    @id @default(uuid())
  
  motion    Motion    @relation(fields: [motionid], references: [id])
  motionid  String

  user      User      @relation(fields: [userid], references: [id])
  userid    String

  value     Int
}
